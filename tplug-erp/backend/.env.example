# TPlug ERP Backend - exemplo de configuracao
# Copie para um arquivo local/secret manager apropriado. Nunca versione valores reais.

# Banco de dados
DB_URL=jdbc:postgresql://localhost:5433/tplug_erp
DB_USERNAME=tplug_erp
DB_PASSWORD=troque-este-valor

# JWT
JWT_SECRET=troque-por-segredo-forte-com-no-minimo-32-bytes
JWT_ISSUER=traxup-tplug-erp
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Aplicacao
SERVER_PORT=8080
OPENAPI_ENABLED=false

# Bootstrap inicial - manter false apos provisionamento
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_TENANT_NAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
